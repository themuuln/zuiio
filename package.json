{
  "name": "zuiio",
  "private": true,
  "scripts": {
    "lint": "biome check",
    "format": "biome format --write",
    "dev:website": "cd apps/website && pnpm dev",
    "dev:zer": "cd apps/zer && pnpm dev",
    "dev:tolom": "cd apps/tolom && pnpm dev",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "mcp:init": "npx tsx scripts/mcp-init.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "react": "^19.2.7",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "apps/zer/src/**/*.{ts,tsx}": [
      "cd apps/zer && biome check --write --no-errors-on-unmatched",
      "cd apps/zer && node scripts/capture-check.mjs"
    ],
    "apps/tolom/src/**/*.{ts,tsx}": [
      "cd apps/tolom && biome check --write --no-errors-on-unmatched",
      "cd apps/tolom && node scripts/capture-check.mjs"
    ]
  }
}

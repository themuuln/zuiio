{
  "name": "zuiio",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "build:zer": "turbo run build --filter=zer",
    "build:tolom": "turbo run build --filter=tolom",
    "build:website": "turbo run build --filter=@zuiio/website",
    "build:zuiio-id": "turbo run build --filter=@zuiio/id",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "dev:website": "turbo run dev --filter=website",
    "dev:zer": "turbo run dev --filter=zer",
    "dev:tolom": "turbo run dev --filter=tolom",
    "dev:zuiio-id": "turbo run dev --filter=@zuiio/id",
    "dev:agent-gateway": "turbo run dev --filter=agent-gateway",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "turbo run typecheck lint --continue",
    "test": "turbo run test",
    "format": "biome format --write",
    "prepare": "husky",
    "mcp:init": "npx tsx scripts/mcp-init.ts",
    "design:check": "bash scripts/design-quality-check.sh",
    "design:score": "echo 'OPTIK skills: use /score in Claude Code or Cursor'",
    "clean:dev": "turbo run clean:dev",
    "clean:turbopack": "find . -type d -name turbopack -path '*/.next/*' -exec rm -rf {} + 2>/dev/null; echo 'Turbopack caches cleaned'"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "^26.1.1",
    "@types/react": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "next": "catalog:",
    "optik-design": "^1.0.0",
    "turbo": "^2.10.4",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "apps/zer/src/**/*.{ts,tsx}": [
      "cd apps/zer && biome check --write --no-errors-on-unmatched",
      "cd apps/zer && node scripts/capture-check.mjs"
    ],
    "apps/tolom/src/**/*.{ts,tsx}": [
      "cd apps/tolom && biome check --write --no-errors-on-unmatched",
      "cd apps/tolom && node scripts/capture-check.mjs"
    ]
  }
}

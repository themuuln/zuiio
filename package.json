{
  "name": "zuiio",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "turbo run typecheck lint --continue",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "verify": "turbo run typecheck lint test:coverage --continue",
    "audit": "turbo run verify && turbo run test:e2e",
    "format": "biome format --write",
    "prepare": "husky",
    "sso:plan": "tsx scripts/sso/cli.ts plan",
    "sso:apply": "tsx scripts/sso/cli.ts apply",
    "sso:doctor": "tsx scripts/sso/cli.ts doctor",
    "mcp:init": "npx tsx scripts/mcp-init.ts",
    "design:check": "bash scripts/design-quality-check.sh",
    "clean:turbopack": "find . -type d -name turbopack -path '*/.next/*' -exec rm -rf {} + 2>/dev/null; echo 'Turbopack caches cleaned'"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "optik-design": "^1.0.0",
    "turbo": "^2.10.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}

{
  "name": "tolom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "validate:types": "tsc --noEmit --incremental",
    "validate:lint": "biome check src/",
    "validate": "pnpm validate:types && pnpm validate:lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:seed": "./supabase/seed-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "percy exec -- npx playwright test",
    "test:e2e:ai:plan": "echo 'Ask Droid to: use playwright-test tools to explore the app and create a test plan in specs/'",
    "test:e2e:ai:heal": "echo 'Ask Droid to: use playwright-test tools to run failing tests, debug, and fix selectors'",
    "test:e2e:ai:codegen": "npx playwright codegen --target playwright-test",
    "docs:dev": "vitepress dev docs",
    "docs:screenshots": "node scripts/screenshots/capture.mjs",
    "docs:screenshots:en": "node scripts/screenshots/capture.mjs --locale en",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "doctor": "npx react-doctor@latest",
    "i18n:check": "node scripts/i18n/check-messages.mjs",
    "i18n:hardcoded": "node scripts/i18n/check-hardcoded-strings.mjs",
    "i18n:baseline": "node scripts/i18n/check-hardcoded-strings.mjs --baseline",
    "i18n:all": "pnpm i18n:check && pnpm i18n:hardcoded -- --check",
    "i18n:dead": "node scripts/i18n/check-dead-keys.mjs"
  },

name: Verify — FastGate
on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".vscode/**"
      - ".gitignore"

permissions:
  contents: read

env:
  TURBO_TOKEN: ${{ secrets.TURBO_TOKEN }}
  TURBO_TEAM: ${{ vars.TURBO_TEAM }}

concurrency:
  group: verify-${{ github.ref }}
  cancel-in-progress: true

jobs:
  fastgate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - uses: pnpm/action-setup@v4
      - run: corepack enable

      - uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: 🔍 Typecheck
        run: pnpm turbo run typecheck --continue
        continue-on-error: true

      - name: 🧹 Lint
        run: pnpm turbo run lint --continue
        continue-on-error: true

      - name: 🧪 Unit tests with coverage
        run: pnpm turbo run test:coverage --continue
        continue-on-error: true

      - name: 📊 Coverage check
        if: always()
        run: |
          echo "=== FastGate Results ==="
          echo "Typecheck, lint, and test coverage gates completed."
          echo "Check individual job steps for pass/fail details."
          echo ""
          echo "To pass FastGate locally:"
          echo "  npm run verify"

      - name: Upload coverage reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-${{ github.sha }}
          path: |
            apps/*/coverage/
            packages/*/coverage/
          retention-days: 7
          include-hidden-files: true

name: _Deploy to Vercel (reusable)

on:
  workflow_call:
    inputs:
      app:
        description: "App directory name (e.g. zer, tolom)"
        required: true
        type: string
      turbo-filter:
        description: "Turbo filter name (e.g. zer, @zuiio/id)"
        required: true
        type: string
      author-email:
        description: "Vercel Hobby account owner email (must match exactly)"
        required: true
        type: string
    secrets:
      VERCEL_TOKEN:
        required: true
      VERCEL_ORG_ID:
        required: true
      VERCEL_PROJECT_ID:
        required: true

# Per-app concurrency: rapid pushes to the same app cancel prior deploys,
# but pushes to different apps run in parallel.
concurrency:
  group: vercel-${{ inputs.app }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
      VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
      VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}

    steps:
      # Sparse checkout: only fetch the app + shared packages (skip unused apps)
      - name: Checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          submodules: false
          persist-credentials: false
          sparse-checkout: |
            apps/${{ inputs.app }}
            packages
            config
            pnpm-lock.yaml
            pnpm-workspace.yaml
            package.json
            turbo.json
            tsconfig.json

      # Hobby plan blocks deploys where commit author != account owner.
      # Amend HEAD author to match the target Vercel account.
      - name: Set Vercel-compatible git author
        env:
          AUTHOR_EMAIL: ${{ inputs.author-email }}
        run: |
          git config user.email "$AUTHOR_EMAIL"
          git config user.name "Temuulen Undrakhbayar"
          git commit --amend --no-edit --reset-author --quiet

      - name: Install pnpm
        uses: pnpm/action-setup@fc06bc1257f339d1d5d8b3a19a8cae5388b55320 # v4.4.0

      - name: Enable corepack
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "24"
          cache: pnpm

      # Pre-flight: verify sparse checkout fetched everything needed
      - name: Verify workspace files
        run: |
          test -f .npmrc
          test -f pnpm-lock.yaml
          test -f pnpm-workspace.yaml
          test -f turbo.json

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Install Vercel CLI
        run: npm i -g vercel@56

      # Stage project.json + vercel.json for CI builds.
      # app-level vercel.json is for Vercel Git integration (CWD inside apps/<app>).
      # CI runs from root, so we generate a root vercel.json with consistent settings.
      - name: Stage Vercel project config
        env:
          TURBO_FILTER: ${{ inputs.turbo-filter }}
        run: |
          mkdir -p .vercel
          jq -n \
            --arg pid "$VERCEL_PROJECT_ID" \
            --arg oid "$VERCEL_ORG_ID" \
            '{projectId: $pid, orgId: $oid}' > .vercel/project.json
          jq -n \
            --arg schema "https://openapi.vercel.sh/vercel.json" \
            --arg filter "$TURBO_FILTER" \
            --arg outDir "apps/${{ inputs.app }}/.next" \
            '{
              "$schema": $schema,
              "framework": "nextjs",
              "outputDirectory": $outDir,
              "installCommand": "pnpm install --frozen-lockfile",
              "buildCommand": ("pnpm exec turbo run build --filter=" + $filter)
            }' > vercel.json

      # Token via env (VERCEL_TOKEN), not --token flag — keeps it out of process args.
      - name: Pull Vercel environment
        run: vercel pull --yes --environment=production

      - name: Build
        run: vercel build --prod

      - name: Deploy to production
        run: vercel deploy --prebuilt --prod --archive=tgz

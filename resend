#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: ./resend <api-key>"
  exit 1
fi

NEW_KEY="$1"

echo "🔍 Reading current keys from Supabase..."
RAW=$(cd "$(dirname "$0")" && supabase db query --linked \
  "SELECT value FROM app_config WHERE key = 'resend_api_keys';" --output json 2>&1)

# Strip "Initialising login role..." line if present, then parse JSON
CLEAN=$(echo "$RAW" | grep -v "^Initialising" | grep -v "^\[$" | grep -v "^\]$" | grep -o '"value": *"[^"]*"' | cut -d'"' -f4 || true)

if [ -z "$CLEAN" ]; then
  echo "📭 No existing keys found. Creating new entry."
  cd "$(dirname "$0")" && supabase db query --linked \
    "INSERT INTO app_config (key, value) VALUES ('resend_api_keys', '$NEW_KEY') ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = now();" >/dev/null 2>&1
else
  echo "📋 Current keys: $(echo "$CLEAN" | tr ',' ' ')"
  UPDATED="${CLEAN},${NEW_KEY}"
  cd "$(dirname "$0")" && supabase db query --linked \
    "UPDATE app_config SET value = '$UPDATED', updated_at = now() WHERE key = 'resend_api_keys';" >/dev/null 2>&1
fi

echo "✅ Done. Verifying..."
cd "$(dirname "$0")" && supabase db query --linked \
  "SELECT value FROM app_config WHERE key = 'resend_api_keys';" --output json 2>&1 | grep -v "^Initialising" | grep -v "^\[$" | grep -v "^\]$"

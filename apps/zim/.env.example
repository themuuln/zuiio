# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# eSIM provider adapter
ESIM_PROVIDER=mock            # mock | airalo | esimaccess | ...
MOCK_PROVIDER_FAILURE_RATE=0  # 0..1, deterministic-by-order failure simulation
MOCK_PROVIDER_ASYNC=false     # true = deliver via webhook path

# QPay
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=            # e.g. https://zim.mn/api/payments/callback
QPAY_MOCK=true                # dev/E2E: fake QPay client + /api/payments/mock-pay

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="zim <noreply@zim.mn>"

# Telegram admin alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Secrets
CRON_SECRET=                  # bearer token for /api/cron/*
ORDER_ACCESS_SECRET=          # HMAC key for delivery-page access tokens
PROVIDER_WEBHOOK_SECRET=      # shared secret for /api/provider/webhook

# Base URL (used in emails and QPay callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

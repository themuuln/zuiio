{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.a5c",
      "!.antigravitycli",
      "!.claude",
      "!.commandcode",
      "!.factory",
      "!opencode",
      "!.kiro",
      "!_scripts",
      "!scratch",
      "!*.css",
      "!src/app/globals.css",
      "!.lighthouserc.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "formatWithErrors": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@/lib/database.types": {
                "message": "Import from @/lib/types instead — database.types.ts is regenerated and may not export this type."
              }
            }
          }
        },
        "useTemplate": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noExplicitAny": "error",
        "noArrayIndexKey": "off",
        "noUnknownAtRules": "off",
        "noDebugger": "error"
      },
      "complexity": {
        "noForEach": "error"
      },
      "a11y": {
        "useAltText": "warn",
        "useValidAnchor": "warn",
        "useButtonType": "warn",
        "useHtmlLang": "warn",
        "useKeyWithClickEvents": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noNoninteractiveTabindex": "warn",
        "noPositiveTabindex": "warn",
        "noRedundantAlt": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsForRole": "warn",
        "useHeadingContent": "warn",
        "useIframeTitle": "warn",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/test/**", "src/**/*.test.*", "src/**/*.spec.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noThenProperty": "off",
            "useIterableCallbackReturn": "off"
          },
          "complexity": {
            "noBannedTypes": "off",
            "noForEach": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/types/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  }
}

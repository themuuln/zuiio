{
  "ignore": [
    "node_modules",
    "*.test.*",
    "*.spec.*",
    "__tests__",
    "dist",
    ".git",
    "*.lock"
  ],
  "fileMapping": {
    "lib/**": "website/docs/features/",
    "src/**": "docs/features/",
    "app/**": "docs/features/"
  },
  "autoCreateDocFor": ["lib/**", "src/**", "app/**"],
  "skipDocUpdateFor": ["*.lock", "*.env", "*.generated.*"]
}

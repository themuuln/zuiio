{
	"id": "zer",
	"name": "Зэр (байгууллагын ERP) — бичих каталог",
	"tenant": { "column": "organization_id", "source": "jwt" },
	"datasets": {
		"products": {
			"source": "products",
			"displayName": "Бараа",
			"insertable": true,
			"updatable": true,
			"deletable": true,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"organization_id": { "type": "uuid", "writable": false },
				"category_id": { "type": "uuid", "required": true },
				"brand_id": { "type": "uuid" },
				"name": { "type": "string", "required": true },
				"sku": { "type": "string" },
				"barcode": { "type": "string" },
				"description": { "type": "text" },
				"cost_price": { "type": "number" },
				"sale_price": { "type": "number", "required": true },
				"current_stock": { "type": "number" },
				"min_stock": { "type": "number" },
				"unit": { "type": "string" },
				"material_type": { "type": "string" },
				"is_public": { "type": "boolean" },
				"additional_info": { "type": "text" },
				"care_instructions": { "type": "text" },
				"usage_instructions": { "type": "text" },
				"image_url": { "type": "string" },
				"image_urls": { "type": "text" },
				"published_by": { "type": "uuid", "writable": false },
				"created_at": { "type": "timestamp", "writable": false },
				"published_at": { "type": "timestamp" },
				"deleted_at": { "type": "timestamp", "writable": false }
			}
		},
		"categories": {
			"source": "categories",
			"displayName": "Ангилал",
			"insertable": true,
			"updatable": true,
			"deletable": true,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"organization_id": { "type": "uuid", "writable": false },
				"name": { "type": "string", "required": true },
				"slug": { "type": "string" },
				"created_at": { "type": "timestamp", "writable": false }
			}
		},
		"contacts": {
			"source": "contacts",
			"displayName": "Харилцагч",
			"insertable": true,
			"updatable": true,
			"deletable": true,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"organization_id": { "type": "uuid", "writable": false },
				"name": { "type": "string", "required": true },
				"type": { "type": "string" },
				"email": { "type": "string" },
				"phone": { "type": "string" },
				"address": { "type": "text" },
				"balance": { "type": "number", "writable": false },
				"points_balance": { "type": "number", "writable": false },
				"credit_limit": { "type": "number" },
				"payment_terms_days": { "type": "number" },
				"customer_segment_id": { "type": "uuid" },
				"created_at": { "type": "timestamp", "writable": false }
			}
		},
		"expenses": {
			"source": "expenses",
			"displayName": "Зардал",
			"insertable": true,
			"updatable": true,
			"deletable": true,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"organization_id": { "type": "uuid", "writable": false },
				"branch_id": { "type": "uuid" },
				"created_by": { "type": "uuid", "writable": false },
				"bank_account_id": { "type": "uuid" },
				"currency_id": { "type": "uuid" },
				"category": { "type": "string", "required": true },
				"description": { "type": "text" },
				"payment_method": { "type": "string" },
				"amount": { "type": "number", "required": true },
				"original_amount": { "type": "number" },
				"exchange_rate": { "type": "number" },
				"expense_date": { "type": "timestamp", "required": true },
				"created_at": { "type": "timestamp", "writable": false },
				"deleted_at": { "type": "timestamp", "writable": false }
			}
		},
		"sales": {
			"source": "sales",
			"displayName": "Борлуулалт",
			"insertable": true,
			"updatable": false,
			"deletable": false,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"organization_id": { "type": "uuid", "writable": false },
				"branch_id": { "type": "uuid", "required": true },
				"contact_id": { "type": "uuid" },
				"created_by": { "type": "uuid", "writable": false },
				"salesperson_id": { "type": "uuid" },
				"bank_account_id": { "type": "uuid" },
				"currency_id": { "type": "uuid" },
				"sale_date": { "type": "timestamp" },
				"status": { "type": "string", "allowedValues": ["pending", "completed", "cancelled", "refunded"] },
				"payment_method": { "type": "string" },
				"total_amount": { "type": "number", "required": true },
				"original_amount": { "type": "number" },
				"paid_amount": { "type": "number" },
				"exchange_rate": { "type": "number" },
				"currency_code": { "type": "string" },
				"currency_symbol": { "type": "string" },
				"payment_splits": { "type": "text" },
				"notes": { "type": "text" },
				"created_at": { "type": "timestamp", "writable": false },
				"deleted_at": { "type": "timestamp", "writable": false }
			}
		},
		"sale_items": {
			"source": "sale_items",
			"displayName": "Борлуулалтын бараа",
			"insertable": true,
			"updatable": true,
			"deletable": false,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"sale_id": { "type": "uuid", "required": true },
				"product_id": { "type": "uuid", "required": true },
				"variant_id": { "type": "uuid" },
				"quantity": { "type": "number", "required": true },
				"unit_price": { "type": "number", "required": true },
				"total_price": { "type": "number" },
				"commission_amount": { "type": "number" },
				"created_at": { "type": "timestamp", "writable": false },
				"deleted_at": { "type": "timestamp", "writable": false }
			}
		},
		"purchase_orders": {
			"source": "purchase_orders",
			"displayName": "Худалдан авалтын захиалга",
			"insertable": true,
			"updatable": true,
			"deletable": true,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"organization_id": { "type": "uuid", "writable": false },
				"branch_id": { "type": "uuid" },
				"created_by": { "type": "uuid", "writable": false },
				"supplier_id": { "type": "uuid", "required": true },
				"currency_id": { "type": "uuid" },
				"order_number": { "type": "string" },
				"status": { "type": "string", "allowedValues": ["draft", "ordered", "received", "cancelled"] },
				"total_amount": { "type": "number" },
				"original_amount": { "type": "number" },
				"exchange_rate": { "type": "number" },
				"order_date": { "type": "timestamp" },
				"expected_date": { "type": "timestamp" },
				"notes": { "type": "text" },
				"created_at": { "type": "timestamp", "writable": false },
				"deleted_at": { "type": "timestamp", "writable": false }
			}
		},
		"purchase_order_items": {
			"source": "purchase_order_items",
			"displayName": "Захиалгын бараа",
			"insertable": true,
			"updatable": true,
			"deletable": false,
			"pk": "id",
			"fields": {
				"id": { "type": "uuid", "writable": false },
				"purchase_order_id": { "type": "uuid", "required": true },
				"product_id": { "type": "uuid", "required": true },
				"variant_id": { "type": "uuid" },
				"description": { "type": "text" },
				"quantity": { "type": "number", "required": true },
				"received_quantity": { "type": "number" },
				"unit_cost": { "type": "number", "required": true },
				"total_cost": { "type": "number" },
				"created_at": { "type": "timestamp", "writable": false },
				"deleted_at": { "type": "timestamp", "writable": false }
			}
		}
	}
}

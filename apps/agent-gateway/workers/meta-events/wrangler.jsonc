{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-gateway-meta-events",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "agent.zuiiotech.com/api/facebook/webhook*",
			"zone_name": "zuiiotech.com"
		}
	],
	"queues": {
		"producers": [
			{ "binding": "META_EVENTS_QUEUE", "queue": "agent-gateway-meta-events" }
		],
		"consumers": [
			{
				"queue": "agent-gateway-meta-events",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 5,
				"retry_delay": 10,
				"max_concurrency": 10,
				"dead_letter_queue": "agent-gateway-meta-events-dlq"
			}
		]
	},
	"triggers": {
		"crons": ["0 2 * * *"]
	}
}

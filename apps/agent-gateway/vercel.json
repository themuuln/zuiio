{
	"installCommand": "cd ../.. && pnpm install --frozen-lockfile --prod=false --filter=agent-gateway...",
	"buildCommand": "cd ../.. && pnpm exec turbo run build --filter=agent-gateway",
	"ignoreCommand": "if [ -z \"$VERCEL_GIT_PREVIOUS_SHA\" ]; then exit 1; fi; cd ../.. && pnpm exec turbo query affected --base=\"$VERCEL_GIT_PREVIOUS_SHA\" --packages agent-gateway --exit-code",
	"outputDirectory": ".next",
	"regions": ["sin1"],
	"crons": [
		{
			"path": "/api/cron/cleanup-sessions",
			"schedule": "0 3 * * *"
		},
		{
			"path": "/api/cron/resume-flows",
			"schedule": "5 3 * * *"
		},
		{
			"path": "/api/cron/briefing",
			"schedule": "0 8 * * *"
		},
		{
			"path": "/api/cron/reminders",
			"schedule": "10 3 * * *"
		},
		{
			"path": "/api/cron/drain-queue",
			"schedule": "15 3 * * *"
		},
		{
			"path": "/api/cron/process-jobs",
			"schedule": "20 3 * * *"
		},
		{
			"path": "/api/cron/re-embed",
			"schedule": "25 3 * * *"
		}
	]
}

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LLM Provider — Primary (OpenCodeGo)
OPENCODE_API_KEY=sk-...
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# LLM Provider — Fallback (optional, only used if DeepSeek fails)
# OPENAI_API_KEY=sk-...
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_BOT_USERNAME=zuiio_bot
TELEGRAM_WEBHOOK_SECRET=<random-32-byte-string>
TOKEN_SIGNING_SECRET=<random-32-byte-string>
AGENT_GATEWAY_URL=https://gateway.yourdomain.com

# API Auth & Dashboard
# Shared server-to-server secret — sent as x-api-key by Zer/Tolom to /api/link/generate and /api/link/code.
# REQUIRED for link APIs (fail-closed when unset). Must match AGENT_GATEWAY_API_SECRET in Zer/Tolom.
AGENT_GATEWAY_API_SECRET=<random-32-byte-string>
# Gate for the ops dashboard (/dashboard/*, /api/dashboard/*). REQUIRED to enable the dashboard (fail-closed when unset).
DASHBOARD_SECRET=<random-32-byte-string>
# Optional but recommended: /api/cron/* and /api/flow/publish require Authorization: Bearer <CRON_SECRET> when set.
CRON_SECRET=<random-32-byte-string>

# Voice STT (Phase 2)
# GROQ_API_KEY=gsk-...

TOLOM_SUPABASE_URL=https://your-tolom-project.supabase.co
TOLOM_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Facebook Messenger/Instagram (for orgs connecting their Pages)
# FB_APP_ID is the Meta App ID (also exposed client-side as NEXT_PUBLIC_FACEBOOK_APP_ID).
NEXT_PUBLIC_FACEBOOK_APP_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
# OAuth callback URL registered in the Meta app (https://<gateway>/api/facebook/callback)
FB_OAUTH_REDIRECT_URI=
# Where to return the user after a successful page connect (per product)
# FB_RETURN_URL_ZER=https://zer.mn/settings
# FB_RETURN_URL_TOLOM=https://tolom.mn/settings
# REQUIRED: AES-256-GCM key for encrypting FB page/user tokens at rest (crypto.ts).
# Without it, tokens are stored as plaintext with a degradation warning.
META_TOKEN_ENCRYPTION_KEY=<random-32-byte-string>

# WhatsApp Cloud API (optional — channel disabled without these)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Redis (optional — in-memory fallback when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Sentry (optional — error capture)
# SENTRY_DSN=

# Debug logging (set to "true" to enable structured debug logs)
DEBUG=true
# Caddyfile — Round-robin load balancer for agent-gateway
# Place on Hetzner VPS at /etc/caddy/Caddyfile

{
	# Email for Let's Encrypt
	email your-email@domain.com
	
	# Admin API (for monitoring)
	admin localhost:2019
}

# Bot endpoint — round-robin between MacBook and iMac
bot.yourdomain.com {
	# Round-robin load balancing
	reverse_proxy {
		# Cloudflare Tunnel URLs for each Mac
		# Replace with your actual tunnel URLs
		to https://macbook-TUNNEL_ID.trycloudflare.com https://imac-TUNNEL_ID.trycloudflare.com
		
		# Round-robin policy (alternates between backends)
		lb_policy round_robin
		
		# Active health checks
		health_uri /api/health
		health_interval 10s
		health_timeout 5s
		health_status 200
		
		# Passive health checks (mark unhealthy after failures)
		fail_duration 30s
		max_fails 3
		
		# Headers
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Logging
	log {
		output file /var/log/caddy/bot.log
		format json
	}
}

# Health check endpoint
:8080 {
	respond /health 200
}

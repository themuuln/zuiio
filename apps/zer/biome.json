{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.vitepress/cache",
      "!.lighthouserc.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useAltText": "warn",
        "useValidAnchor": "warn",
        "useButtonType": "warn",
        "useHtmlLang": "warn",
        "useKeyWithClickEvents": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noNoninteractiveTabindex": "warn",
        "noPositiveTabindex": "warn",
        "noRedundantAlt": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsForRole": "warn",
        "useHeadingContent": "warn",
        "useIframeTitle": "warn",
        "useMediaCaption": "warn",
        "useSemanticElements": "warn"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useTemplate": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noArrayIndexKey": "warn",
        "noExplicitAny": "error",
        "noUnknownAtRules": "off",
        "noDebugger": "error"
      },
      "complexity": {
        "noForEach": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/(dashboard)/bom/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off",
            "noDebugger": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/(dashboard)/products/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off",
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/(dashboard)/shop/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/midscene/**"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

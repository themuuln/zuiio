{
  "name": "zer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "lint": "biome check && node scripts/capture-check.mjs",
    "format": "biome format --write",
    "clean:dev": "rm -rf .next/cache/turbopack .next/dev/cache/turbopack",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run typecheck && npm run test:unit && npm run test",
    "test:ci": "npm run typecheck && npm run test:unit && npm run test && npm run test:e2e:all && npm run test:e2e:a11y",
    "test:e2e": "playwright test",
    "test:e2e:ai": "codeceptjs run --ai",
    "test:e2e:smoke": "playwright test e2e/app-smoke.spec.ts",
    "prepare": "husky",
    "mcp:init": "npx tsx scripts/mcp-init.ts",
    "design:check": "bash scripts/design-quality-check.sh",
    "design:score": "echo 'OPTIK skills available via AI agent — use /score command in Claude Code or Cursor'",
    "test:e2e:all": "playwright test --ignore='**/codeceptjs/**' --ignore='**/fixture.ts' --ignore='**/seed.spec.ts' --ignore='**/midscene_run/**'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/sentry-js-integration": "^0.3.0",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "@zuiio/ai-agent": "workspace:*",
    "@zuiio/branding": "workspace:*",
    "@zuiio/capture": "workspace:*",
    "@zuiio/core": "workspace:*",
    "@zuiio/export": "workspace:*",
    "@zuiio/hooks": "workspace:*",
    "@zuiio/hr": "workspace:*",
    "@zuiio/query": "workspace:*",
    "@zuiio/realtime": "workspace:*",
    "@zuiio/search": "workspace:*",
    "@zuiio/supabase": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "react-resizable-panels": "^4.12.0",
    "recharts": "^3.9.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "biome check --no-errors-on-unmatched"
    ],
    "*.{json,css,md}": [
      "biome check --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "catalog:",
    "@codeceptjs/configure": "4.0.0-beta.4",
    "@midscene/web": "^1.10.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "codeceptjs": "^4.0.9",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "mermaid": "^11.16.0",
    "react-grab": "^0.1.47",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^6.0.2",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-viewer": "^0.4.0",
    "vitest": "catalog:",
    "wait-on": "^9.0.10"
  }
}

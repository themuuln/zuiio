{
  "name": "zer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "lint": "biome check && node scripts/capture-check.mjs",
    "format": "biome format --write",
    "clean:dev": "rm -rf .next/cache/turbopack .next/dev/cache/turbopack",
    "typecheck": "tsc --noEmit",
    "test:unit": "for f in tests/*.test.ts; do if [ -f \"$f\" ]; then tsx --experimental-test-module-mocks --test \"$f\" || exit 1; fi; done",
    "test": "pnpm run test:unit && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm run typecheck && pnpm run test",
    "test:ci": "pnpm run typecheck && pnpm run test && pnpm run test:e2e:all && pnpm run test:e2e:a11y",
    "test:e2e": "playwright test",
    "test:e2e:ai": "codeceptjs run --ai",
    "test:e2e:smoke": "playwright test e2e/app-smoke.spec.ts",
    "test:e2e:a11y": "playwright test e2e/a11y",
    "test:e2e:all": "playwright test",
    "prepare": "husky",
    "mcp:init": "npx tsx scripts/mcp-init.ts",
    "design:check": "bash scripts/design-quality-check.sh",
    "design:score": "echo 'OPTIK skills available via AI agent — use /score command in Claude Code or Cursor'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },

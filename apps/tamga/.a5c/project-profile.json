{
  "projectName": "Tamga",
  "description": "Offline-first Flutter + Supabase horse management app for Mongolia. Manages horse records, pedigree/lineage, health, breeding, events, marketplace, and co-ownership for Mongolian horse owners.",
  "goals": [
    {
      "id": "goal-production-1",
      "description": "Build production-quality app with proper sync, auth, offline-first architecture from the start",
      "category": "quality",
      "priority": "high",
      "status": "active"
    },
    {
      "id": "goal-stability-1",
      "description": "Complete Phase 1: Local-First Stabilization",
      "category": "stability",
      "priority": "high",
      "status": "active"
    },
    {
      "id": "goal-auth-1",
      "description": "Implement multi-provider auth (Phone OTP primary, then Email/Password and OAuth)",
      "category": "feature",
      "priority": "high",
      "status": "active"
    },
    {
      "id": "goal-sync-1",
      "description": "Implement sync queue with conflict resolution for offline-first data consistency",
      "category": "feature",
      "priority": "medium",
      "status": "active"
    },
    {
      "id": "goal-launch-1",
      "description": "Prepare for beta testing and App Store submission",
      "category": "launch",
      "priority": "high",
      "status": "planned"
    }
  ],
  "techStack": {
    "languages": [
      {
        "name": "Dart",
        "version": "^3.10.3",
        "role": "primary"
      },
      {
        "name": "TypeScript",
        "role": "Edge Functions"
      },
      {
        "name": "SQL",
        "role": "database migrations"
      }
    ],
    "frameworks": [
      {
        "name": "Flutter",
        "version": "^3.10.3",
        "category": "mobile framework"
      },
      {
        "name": "Riverpod",
        "version": "^2.6.1",
        "category": "state management"
      },
      {
        "name": "GoRouter",
        "version": "^16.0.0",
        "category": "routing"
      },
      {
        "name": "Supabase Flutter SDK",
        "version": "^2.12.4",
        "category": "BaaS client"
      },
      {
        "name": "Isar",
        "version": "^3.1.0+1",
        "category": "local database"
      },
      {
        "name": "VitePress",
        "version": "^1.6.4",
        "category": "documentation"
      },
      {
        "name": "MapLibre GL",
        "version": "^0.26.1",
        "category": "maps"
      },
      {
        "name": "Firebase Core",
        "version": "^3.13.1",
        "category": "push notifications"
      },
      {
        "name": "Firebase Messaging",
        "version": "^15.2.1",
        "category": "push notifications"
      }
    ],
    "databases": [
      {
        "name": "PostgreSQL",
        "type": "relational",
        "via": "Supabase",
        "rlsPolicies": true
      },
      {
        "name": "Isar",
        "type": "embedded",
        "version": "^3.1.0+1",
        "schemaCount": 15
      },
      {
        "name": "SharedPreferences",
        "type": "key-value",
        "notes": "Used for feature flags only, Isar for all data"
      }
    ],
    "buildTools": [
      "flutter build",
      "build_runner ^2.4.0",
      "isar_generator ^3.1.0+1",
      "flutter_launcher_icons ^0.14.3"
    ],
    "packageManagers": [
      "pub (flutter/dart)",
      "npm (docs site only)"
    ],
    "infrastructure": [
      {
        "name": "Supabase Cloud",
        "category": "BaaS",
        "services": [
          "PostgreSQL",
          "Auth",
          "Storage",
          "Realtime",
          "Edge Functions"
        ]
      },
      {
        "name": "Vercel",
        "category": "Documentation Hosting",
        "url": "https://docs.tamga.app"
      },
      {
        "name": "GitHub",
        "category": "Source Control",
        "url": "https://github.com/themuuln/tamga"
      }
    ]
  },
  "architecture": {
    "pattern": "Clean Architecture with feature modules",
    "modules": [
      {
        "name": "horses",
        "path": "lib/src/features/horses/",
        "description": "Horse records CRUD, health logs, co-ownership, transfer, stamp tracing",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "lineage",
        "path": "lib/src/features/lineage/",
        "description": "Pedigree tree visualization, inbreeding calculator",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "market",
        "path": "lib/src/features/market/",
        "description": "Marketplace: buy/sell/lease, digital certificates, boost/VIP/badges",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "map",
        "path": "lib/src/features/map/",
        "description": "MapLibre GL, lost horse reports, geofencing, nearby horses",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "onboarding",
        "path": "lib/src/features/onboarding/",
        "description": "Multi-step onboarding, role selection, profile setup",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "events",
        "path": "lib/src/features/events/",
        "description": "Tournaments, races, competitions, exhibitions",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "breeding",
        "path": "lib/src/features/breeding/",
        "description": "Breeding records, gestation calculator",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "payments",
        "path": "lib/src/features/payments/",
        "description": "Subscription management, feature gating",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "auth",
        "path": "lib/src/features/auth/",
        "description": "Phone OTP, email/password, multi-provider auth",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "profile",
        "path": "lib/src/features/profile/",
        "description": "User profile, notification preferences",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "health",
        "path": "lib/src/features/health/",
        "description": "Health and farrier logs",
        "layers": [
          "data",
          "application"
        ]
      },
      {
        "name": "documents",
        "path": "lib/src/features/documents/",
        "description": "Document vault",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "certificates",
        "path": "lib/src/features/certificates/",
        "description": "Digital ownership certificates",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "stable",
        "path": "lib/src/features/stable/",
        "description": "Stable/yard management",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "shared",
        "path": "lib/src/features/shared/",
        "description": "Isar schemas (15), pagination, shared models",
        "layers": [
          "domain",
          "data",
          "application",
          "presentation"
        ]
      },
      {
        "name": "shell",
        "path": "lib/src/features/shell/",
        "description": "Bottom navigation shell",
        "layers": [
          "presentation"
        ]
      },
      {
        "name": "search",
        "path": "lib/src/features/search/",
        "description": "Search screen",
        "layers": [
          "application",
          "presentation"
        ]
      },
      {
        "name": "session",
        "path": "lib/src/features/session/",
        "description": "Session management",
        "layers": [
          "application"
        ]
      }
    ],
    "entryPoints": [
      "lib/main.dart"
    ],
    "dataFlow": "UI (Presentation) → Riverpod Provider (Application) → Repository (Data) → Local Isar Store + SyncQueue → Background SyncEngine → Supabase"
  },
  "team": [
    {
      "name": "Temuulen Undrakhbayar",
      "role": "Solo Developer / Frontend Developer",
      "responsibilities": [
        "Full-stack Flutter development",
        "UI/UX design",
        "Backend (Supabase)",
        "Architecture",
        "Testing"
      ]
    }
  ],
  "workflows": [
    {
      "name": "development",
      "description": "Standard Flutter dev workflow",
      "steps": [
        "flutter pub get",
        "flutter run"
      ],
      "triggers": [
        "manual"
      ]
    },
    {
      "name": "schema-generation",
      "description": "Generate Isar schemas",
      "steps": [
        "dart run build_runner build --delete-conflicting-outputs"
      ],
      "triggers": [
        "manual"
      ]
    },
    {
      "name": "testing",
      "description": "Run all unit and widget tests",
      "steps": [
        "flutter test"
      ],
      "triggers": [
        "manual"
      ]
    },
    {
      "name": "documentation",
      "description": "VitePress docs dev/build/preview",
      "steps": [
        "npm run docs:dev"
      ],
      "triggers": [
        "manual"
      ]
    },
    {
      "name": "tile-download",
      "description": "Download Mongolia PMTiles",
      "steps": [
        "./scripts/download_mongolia_tiles.sh"
      ],
      "triggers": [
        "manual"
      ]
    },
    {
      "name": "babysitter-sprints",
      "description": "Orchestrated phased development via Babysitter",
      "triggers": [
        "manual",
        "AI agent invocation"
      ]
    },
    {
      "name": "release-checklist",
      "description": "Pre-launch checklist from DEFERRED.md",
      "triggers": [
        "manual"
      ]
    }
  ],
  "conventions": {
    "naming": {
      "files": "snake_case.dart",
      "classes": "PascalCase",
      "variables": "camelCase",
      "constants": "k prefix",
      "providers": "{name}Provider",
      "repositories": "{Name}Repository",
      "localRepositories": "local_{name}_repository.dart",
      "supabaseRepositories": "supabase_{name}_repository.dart",
      "sharedWidgets": "tamga_{name}.dart prefix"
    },
    "git": {
      "branchStrategy": "main with worktrees via Worktrunk",
      "commitStyle": "conventional-commits",
      "branchNaming": "feature/scope description",
      "mainBranch": "main"
    },
    "codeStyle": {
      "documentation": "Doc comments (///) on all public APIs",
      "bilingual": "Mongolian for UI text, English for code",
      "sectionDividers": "// ── Section ── dashes",
      "commentedOutCode": "Prohibited"
    },
    "importOrder": [
      "dart:",
      "flutter:",
      "third-party",
      "relative"
    ],
    "errorHandling": "Result<T> sealed class (Ok/Fail) wrapping AppException with code, message, details. All repository methods return Future<Result<T>>.",
    "testingConventions": "flutter_test + mocktail, mirrors lib/ structure under test/, 52 test files",
    "additionalRules": [
      "Domain layer pure Dart only",
      "Each feature self-contained with domain/data/application/presentation",
      "Isar schemas in shared/data/isar_schemas/",
      "Doc comments on public APIs",
      "No commented-out code",
      "Test-before-commit: All new features and bug fixes must include tests. Run flutter test before committing."
    ]
  },
  "painPoints": [
    {
      "id": "pp-workflow-1",
      "description": "No incremental git history — single bulk backup commit",
      "severity": "high",
      "category": "workflow"
    },
    {
      "id": "pp-codequality-1",
      "description": "Large files needing decomposition (horses_screen: 1224 lines)",
      "severity": "medium",
      "category": "code-quality"
    },
    {
      "id": "pp-architecture-1",
      "description": "Double domain model (HorseRecord vs LineageHorse)",
      "severity": "medium",
      "category": "architecture"
    },
    {
      "id": "pp-branching-1",
      "description": "No branching strategy - all commits land on main with no feature isolation",
      "severity": "high",
      "category": "workflow"
    },
    {
      "id": "pp-release-1",
      "description": "No release process or versioning - no tags, no CHANGELOG",
      "severity": "medium",
      "category": "workflow"
    },
    {
      "id": "pp-market-migration-1",
      "description": "Triple repository pattern in market feature - incomplete migration",
      "severity": "medium",
      "category": "architecture"
    },
    {
      "id": "pp-test-coverage-1",
      "description": "Test coverage sparse relative to feature velocity",
      "severity": "medium",
      "category": "testing"
    }
  ],
  "bottlenecks": [
    {
      "id": "bn-structure-1",
      "description": "No CI/CD pipeline",
      "impact": "Manual builds and tests",
      "location": ".github/workflows/",
      "frequency": "always"
    },
    {
      "id": "bn-router-1",
      "description": "app_router.dart central coupling point",
      "impact": "High - serial bottleneck for all features",
      "location": "lib/src/app/router/app_router.dart",
      "frequency": "6 commits"
    },
    {
      "id": "bn-market-1",
      "description": "Market feature 4 repository files with tight coupling",
      "impact": "High - incomplete migration",
      "location": "lib/src/features/market/data/",
      "frequency": "3 commits"
    }
  ],
  "cicd": {
    "provider": "none",
    "configPaths": [],
    "pipelines": [],
    "babysitterIntegration": {
      "enabled": false
    }
  },
  "installedProcesses": [

{
  "qualityThreshold": 80,
  "testCoverage": {
    "minimum": 60,
    "note": "New project — target 60%, increase as coverage grows"
  },
  "linting": {
    "tool": "flutter_lints",
    "configFile": "analysis_options.yaml",
    "command": "flutter analyze"
  },
  "formatting": {
    "tool": "dart format",
    "command": "dart format --output=none --set-exit-if-changed ."
  },
  "commitChecks": [
    "flutter analyze",
    "flutter test"
  ],
  "deployGates": [
    "flutter analyze --no-fatal-infos",
    "flutter test",
    "dart format --output=none --set-exit-if-changed ."
  ]
}

#!/usr/bin/env bash
# Tamga pre-commit hook
#
# Fast path: only checks staged files.
# - Format check (full project — fast, just checks for dirty files)
# - Static analysis on staged files only
# - Tests matching staged changes only
#
# Install: git config core.hooksPath .githooks
# Run manually: .githooks/pre-commit

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'
PASS="${GREEN}✓${NC}"
FAIL="${RED}✗${NC}"

echo "━━━ Tamga pre-commit checks ━━━"
FAILED=0

# 1. Format check
echo -n "  Formatting  "
if dart format --output=none --set-exit-if-changed . 2>/dev/null; then
  echo -e "$PASS"
else
  echo -e "$FAIL"
  echo "    Run 'dart format .' to fix."
  FAILED=1
fi

# 2. Static analysis + tests — fast path on staged files only
CHANGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)

if [ -z "$CHANGED_DART" ]; then
  echo "  Analysis    — (no staged dart files)"
  echo "  Tests       — (no staged dart files)"
else
  # 2a. Analyze only changed files (much faster than full project)
  echo -n "  Analysis    "
  if dart analyze --fatal-infos $CHANGED_DART 2>/dev/null; then
    echo -e "$PASS"
  else
    echo -e "$FAIL"
    FAILED=1
  fi

  # 2b. Run only tests that cover the changed files
  TEST_TARGETS=""
  for f in $CHANGED_DART; do
    base="${f#lib/}"
    base="${base#test/}"
    test_file="test/${base%.dart}_test.dart"
    [ -f "$test_file" ] && TEST_TARGETS="$TEST_TARGETS $test_file"
  done

  if [ -n "$TEST_TARGETS" ]; then
    echo -n "  Tests       "
    if flutter test --timeout 60s $TEST_TARGETS 2>/dev/null; then
      echo -e "$PASS"
    else
      echo -e "$FAIL"
      FAILED=1
    fi
  else
    echo "  Tests       — (no matching tests)"
  fi
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ "$FAILED" -eq 0 ]; then
  echo -e "${GREEN}All checks passed.${NC}"
  exit 0
else
  echo -e "${RED}Some checks failed. Fix before commit.${NC}"
  exit 1
fi

#!/usr/bin/env bash
# Tamga pre-commit hook
#
# Matches the CI quality gate: format check → strict analysis → test.
# Uses a fast path for tests (changed files only) instead of full suite.
#
# Install: git config core.hooksPath .githooks
# Run manually: .githooks/pre-commit

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color
PASS="${GREEN}✓${NC}"
FAIL="${RED}✗${NC}"

echo "━━━ Tamga pre-commit checks ━━━"
FAILED=0

# 1. Format check
echo -n "  Formatting  "
if dart format --output=none --set-exit-if-changed . 2>/dev/null; then
  echo -e "$PASS"
else
  echo -e "$FAIL"
  echo "    Run 'dart format .' to fix."
  FAILED=1
fi

# 2. Static analysis (strict — infos as errors)
echo -n "  Analysis    "
if dart analyze --fatal-infos 2>/dev/null; then
  echo -e "$PASS"
else
  echo -e "$FAIL"
  FAILED=1
fi

# 3. Tests — fast path on changed files
echo -n "  Tests       "
CHANGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)
TEST_TARGETS=""
if [ -n "$CHANGED_DART" ]; then
  for f in $CHANGED_DART; do
    # Map lib/.../foo.dart → test/.../foo_test.dart
    base="${f#lib/}"
    base="${base#test/}"
    test_file="test/${base%.dart}_test.dart"
    [ -f "$test_file" ] && TEST_TARGETS="$TEST_TARGETS $test_file"
  done
fi

if [ -n "$TEST_TARGETS" ]; then
  if flutter test $TEST_TARGETS 2>/dev/null; then
    echo -e "$PASS"
  else
    echo -e "$FAIL"
    FAILED=1
  fi
else
  echo "— (no matching tests)"
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ "$FAILED" -eq 0 ]; then
  echo -e "${GREEN}All checks passed.${NC}"
  exit 0
else
  echo -e "${RED}Some checks failed. Fix before commit.${NC}"
  exit 1
fi

# Identity Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Identity app origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: NEXT_PUBLIC_SITE_URL=https://id.zuiiotech.com
# Sentry DSNs (leave empty to disable telemetry locally)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# HMAC secret for continuation tokens (generate with: openssl rand -hex 32)
ZUIIO_CONTINUATION_SECRET=change-me-in-production

# Social providers (configured in Supabase Dashboard > Authentication > Providers)
# Google and Apple are configured in the Supabase project, not here.
# NEXT_PUBLIC_FACEBOOK_AUTH_ENABLED=false

{
  "architecture": {
    "pattern": "single-page application (client-side rendered)",
    "modules": [
      {"name": "app", "path": "src/app", "description": "Next.js App Router pages and layout"},
      {"name": "components", "path": "src/components", "description": "UI components: app-shell, screens (home, practice, progress, profile, session, result, onboarding)"},
      {"name": "hooks", "path": "src/hooks", "description": "React hooks — use-learning.tsx (LearningProvider context)"},
      {"name": "lib", "path": "src/lib", "description": "Core logic: data-loader, learning-engine, models, question-bank, storage, utils"},
      {"name": "ui", "path": "src/components/ui", "description": "shadcn/ui base components"},
      {"name": "data", "path": "public/data/traffic_institute", "description": "Static JSON question data + images loaded at runtime"}
    ],
    "entryPoints": ["src/app/layout.tsx", "src/app/page.tsx"],
    "dataFlow": "Static JSON files in public/data/ → fetch() in data-loader.ts → LearningEngine processes → React context (use-learning) → Screen components render → localStorage for persistence"
  },
  "techStack": {
    "languages": [
      {"name": "TypeScript", "role": "primary"},
      {"name": "CSS", "role": "styling (Tailwind)"}
    ],
    "frameworks": [
      {"name": "Next.js", "version": "16.2.6", "category": "meta-framework"},
      {"name": "React", "version": "19.2.4", "category": "UI library"},
      {"name": "Tailwind CSS", "version": "4", "category": "utility CSS"},
      {"name": "React Compiler", "version": "1.0.0", "category": "build optimization"}
    ],
    "databases": [],
    "buildTools": ["Next.js (Turbopack)", "PostCSS"],
    "packageManagers": ["pnpm", "npm (lockfile present)"],
    "infrastructure": [
      {"name": "Vercel", "category": "hosting (target)"}
    ]
  },
  "conventions": {
    "naming": {
      "components": "kebab-case files, PascalCase exports",
      "hooks": "use-*.tsx pattern",
      "lib": "kebab-case utility modules"
    },
    "codeStyle": {
      "linter": "Biome (biome.json)",
      "formatter": "Biome format",
      "no ESLint": true
    },
    "importOrder": ["@/ (path alias to src/)", "external packages"],
    "errorHandling": "try-catch with silent fallback in storage/data-loader",
    "testingConventions": "No tests configured yet",
    "additionalRules": [
      "React Compiler enabled (babel-plugin-react-compiler)",
      "suppressHydrationWarning on <html> for dark mode",
      "All data loaded client-side via fetch to static JSON",
      "No server components — entire app is 'use client'"
    ]
  },
  "documentation": [
    {"path": "README.md", "type": "readme", "summary": "Create Next.js boilerplate readme"},
    {"path": "AGENTS.md", "type": "config", "summary": "Global agent config (symlinked)"},
    {"path": "CLAUDE.md", "type": "config", "summary": "Agent instructions (symlink to AGENTS.md)"}
  ],
  "directoryTree": {
    "src": {
      "app": ["layout.tsx", "page.tsx", "globals.css", "favicon.ico"],
      "components": ["app-shell.tsx", "home-screen.tsx", "onboarding-screen.tsx", "practice-screen.tsx", "profile-screen.tsx", "progress-screen.tsx", "result-screen.tsx", "session-screen.tsx", "ui/"],
      "hooks": ["use-learning.tsx"],
      "lib": ["data-loader.ts", "learning-engine.ts", "models.ts", "question-bank.ts", "storage.ts", "utils.ts"]
    },
    "public": {
      "data": {
        "traffic_institute": {
          "app_ready": ["categories/", "images/", "question_bank_index.json", "question_bank.json"],
          "mirror": ["(50 referenced image files)"],
          "tests_playwright.json": true
        }
      }
    }
  }
}

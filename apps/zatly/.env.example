# -----------------------------------------------------------------------------
# APP SECURITY
# -----------------------------------------------------------------------------
# API key for protecting admin API routes. Generate with: openssl rand -hex 32
# All /api/ routes (except /api/webhook) require this via x-api-key header.
API_KEY=""

# -----------------------------------------------------------------------------
# FACEBOOK MESSENGER INTEGRATION
# -----------------------------------------------------------------------------

# 1. FB_VERIFY_TOKEN
# Used ONLY once when setting up the webhook in the Meta Developer Dashboard.
# You can make this up. It just needs to match exactly what you enter in the
# "Verify Token" field on the Webhooks setup page.
FB_VERIFY_TOKEN="my_super_secret_verify_token"

# 2. FB_PAGE_ACCESS_TOKEN
# Generated in the Meta Dashboard under: Messenger -> Settings -> Access Tokens.
# This acts as the "password" that allows your app to send messages TO users
# on behalf of your Facebook Page.
# Format: A very long string of letters and numbers (often starts with 'EAA...')
FB_PAGE_ACCESS_TOKEN=""
# Optional Graph API version for outgoing messages.
FB_GRAPH_API_VERSION="v25.0"
# Optional: exported flow JSON (from Sidebar -> Export in Flow Builder).
FB_BOT_FLOW_JSON=""
# Optional: fallback reply when no flow matches.
FB_FALLBACK_MESSAGE="Thanks for your message. A team member will reply soon."

# 3. FB_APP_SECRET
# Found in the Meta Dashboard under: App Settings -> Basic -> App Secret.
# You will need to enter your Facebook password to reveal it.
# This is used to cryptographically verify that incoming webhooks are actually
# coming from Facebook and not a malicious third party.
FB_APP_SECRET=""

# 4. FB_APP_ID
# Found in the Meta Dashboard under: App Settings -> Basic -> App ID.
FB_APP_ID=""

# Optional alternative to FB_APP_ID.
# If FB_APP_ID is empty, the connector will use NEXT_PUBLIC_FB_APP_ID.
NEXT_PUBLIC_FB_APP_ID=""

# 5. FB_OAUTH_REDIRECT_URI
# OAuth callback route configured in Facebook Login settings.
# Example: http://localhost:3000/api/facebook/callback
FB_OAUTH_REDIRECT_URI="http://localhost:3000/api/facebook/callback"

# 6. APP_URL
# Base URL used by the OAuth callback to redirect back to the app UI.
# Example (local): http://localhost:3000
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# SUPABASE FLOW PUBLISH (FOR SAVE & PUBLISH BUTTON)
# -----------------------------------------------------------------------------
# Personal access token from Supabase account settings.
# Used server-side to update project secrets via Management API.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=""
# Optional explicit project ref. If empty, server will try parsing from
# NEXT_PUBLIC_SUPABASE_URL (e.g. https://<project-ref>.supabase.co).
SUPABASE_PROJECT_REF=""

# -----------------------------------------------------------------------------
# SUPABASE CONTACTS FEATURE (FOR CONTACTS SCREEN)
# -----------------------------------------------------------------------------
# Your Supabase project URL. Example:
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL=""

# Service role key for server-side REST API calls from Next.js API routes.
# Never expose this on the client.
SUPABASE_SERVICE_ROLE_KEY=""

{
  "name": "onoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next/dev .next/cache && next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "validate:types": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --incremental",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:db:setup": "npx tsx src/test/apply-migrations.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "npx playwright install --with-deps chromium",
    "test:e2e:ci": "pnpm test:e2e:install && pnpm test:e2e",
    "clean:dev": "rm -rf .next/cache/turbopack .next/dev/cache/turbopack"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@onoo/core": "workspace:*",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "date-fns-tz": "^3.2.0",
    "idb": "^8.0.3",
    "lucide-react": "catalog:",
    "motion": "^12.42.2",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-markdown": "^10.1.0",
    "recharts": "catalog:",
    "remark-gfm": "^4.0.1",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "catalog:",
    "pg": "^8.22.0",
    "react-grab": "^0.1.50",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

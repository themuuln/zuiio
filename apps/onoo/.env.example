# Onoo basketball stats platform
# Onoo — Environment Variables
# Copy to .env.local and fill in values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Feature flags (optional)
# ONOO_INTERNAL_DEMO=1

# GlitchTip (optional — free error tracking via app.glitchtip.com)
# Sign up, create a project, then set the DSN below:
# NEXT_PUBLIC_GLITCHTIP_DSN=https://your-key@app.glitchtip.com/1
# Sat Jul 18 14:57:15 +08 2026

# Admin dev credentials (dev only; optional defaults: admin@onoo.mn / onoo2026)
# NEXT_PUBLIC_ADMIN_DEV_EMAIL=admin@onoo.mn
# NEXT_PUBLIC_ADMIN_DEV_PASSWORD=onoo2026

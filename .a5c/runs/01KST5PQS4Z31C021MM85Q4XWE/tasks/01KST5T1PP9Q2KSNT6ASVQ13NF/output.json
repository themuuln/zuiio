{
  "tools": {
    "linting": [{"name": "Biome", "version": "2.2.0", "config": "biome.json", "purpose": "Linting + formatting + import organization"}],
    "testing": [
      {"name": "Vitest", "version": "3.2.4", "config": "vitest.config.mts", "purpose": "Unit/integration testing"},
      {"name": "Playwright", "version": "1.60.0", "config": "playwright.config.ts", "purpose": "E2E testing"},
      {"name": "react-doctor", "version": "0.2.9", "purpose": "React code quality analysis"}
    ],
    "formatting": [{"name": "Biome", "version": "2.2.0", "purpose": "Code formatting"}]
  },
  "cicd": {
    "provider": "GitHub Actions",
    "configPaths": [".github/workflows/ci.yml", ".github/workflows/react-doctor.yml"],
    "pipelines": [
      {"name": "CI", "trigger": "pull_request + push to main", "stages": ["lint", "typecheck", "test", "build"]},
      {"name": "React Doctor", "trigger": "pull_request + push to main", "stages": ["diff analysis", "PR comment"]}
    ]
  },
  "services": [
    {"name": "Supabase", "type": "backend-as-a-service", "url": "https://supabase.com"},
    {"name": "Vercel", "type": "hosting", "url": "https://vercel.com"},
    {"name": "Sentry", "type": "error-monitoring", "url": "https://sentry.io"},
    {"name": "Resend", "type": "email", "url": "https://resend.com"},
    {"name": "SmartCar.mn", "type": "vehicle-lookup", "url": "https://smartcar.mn"}
  ],
  "workflows": [
    {"name": "Development", "description": "Local dev with hot reload", "steps": ["pnpm install", "pnpm dev"], "triggers": ["manual"]},
    {"name": "CI/CD", "description": "Automated quality gates", "steps": ["lint", "typecheck", "test", "build"], "triggers": ["PR", "push to main"]},
    {"name": "Deployment", "description": "Vercel auto-deploy on merge", "steps": ["merge to main", "Vercel build", "Vercel deploy"], "triggers": ["merge to main"]}
  ],
  "externalIntegrations": [
    {"service": "Supabase Auth", "category": "authentication", "enabled": true},
    {"service": "Supabase Database", "category": "database", "enabled": true},
    {"service": "Supabase Edge Functions", "category": "serverless", "enabled": true},
    {"service": "Sentry Error Tracking", "category": "monitoring", "enabled": true},
    {"service": "Resend Email", "category": "email", "enabled": true},
    {"service": "SmartCar.mn", "category": "vehicle-data", "enabled": true}
  ],
  "containerization": {"docker": false, "note": "Serverless deployment on Vercel"},
  "infrastructure": {"hosting": "Vercel", "database": "Supabase (managed PostgreSQL)", "cron": "pg_cron + pg_net", "monitoring": "Sentry"}
}

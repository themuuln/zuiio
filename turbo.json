{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "pages/**", "next.config.*", "tsconfig.json", "package.json", "tailwind.config.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN"
      ],
      "passThroughEnv": [
        "AGENT_GATEWAY_URL",
        "RESEND_API_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "POSTGRES_URL",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_USER",
        "POSTGRES_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_DATABASE",
        "SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_JWT_SECRET",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "EMAIL_FROM",
        "SMTP_USER",
        "SMTP_SECURE",
        "SMTP_PASS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "inputs": ["src/**", "app/**", "pages/**", "tsconfig.json", "package.json"]
    },
    "lint": {
      "inputs": ["src/**", "app/**", "pages/**", "package.json", "biome.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "vitest.config.*"]
    }
  }
}

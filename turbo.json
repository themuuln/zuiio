{
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "config/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN"
      ],
      "passThroughEnv": [
        "AGENT_GATEWAY_URL",
        "GROQ_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "app/**",
        "pages/**",
        "tsconfig.json",
        "package.json"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        "app/**",
        "pages/**",
        "package.json",
        "biome.json"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "vitest.config.*"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "vitest.config.*"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/__integration__/**",
        "vitest.integration.config.ts",
        "vitest.integration.setup.ts"
      ],
      "outputs": []
    }
  }
}

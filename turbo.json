{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "pages/**", "next.config.*", "tsconfig.json", "package.json", "tailwind.config.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN"
      ],
      "passThroughEnv": [
        "AGENT_GATEWAY_URL",
        "OPENCODE_API_KEY",
        "OPENCODE_BASE_URL",
        "OPENCODE_MODEL",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_BOT_USERNAME",
        "TELEGRAM_WEBHOOK_SECRET",
        "TOKEN_SIGNING_SECRET",
        "TOLOM_SUPABASE_URL",
        "TOLOM_SUPABASE_SERVICE_ROLE_KEY",
        "FB_APP_SECRET",
        "FB_VERIFY_TOKEN",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_URL",
        "GROQ_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "inputs": ["src/**", "app/**", "pages/**", "tsconfig.json", "package.json"]
    },
    "lint": {
      "inputs": ["src/**", "app/**", "pages/**", "package.json", "biome.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "vitest.config.*"]
    }
  }
}

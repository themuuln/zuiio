#!/bin/sh

# ──────────────────────────────────────────────────
# pre-push: lightweight validation before push
# Full CI validation happens in GitHub Actions
# ──────────────────────────────────────────────────

# Parse stdin for pushes targeting 'refs/heads/main'
PUSHING_TO_MAIN=false
while read local_ref local_commit remote_ref remote_commit; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    PUSHING_TO_MAIN=true
  fi
done

# On main-branch pushes, run validation
if [ "$PUSHING_TO_MAIN" = "true" ]; then
  echo "🔍 Push to main detected — running scoped typecheck..."
  CHANGED_PACKAGES=$(git diff --name-only HEAD~1..HEAD 2>/dev/null | cut -d/ -f2 | sort -u | tr '\n' ' ')
  FILTERS=""
  for PACKAGE in $CHANGED_PACKAGES; do
    if [ -f "packages/$PACKAGE/package.json" ]; then
      FILTERS="$FILTERS --filter=./packages/$PACKAGE..."
    fi
  done
  if [ -n "$FILTERS" ]; then
    # Scoped to the changed packages and their workspace dependencies.
    echo "  Packages: $(echo "$CHANGED_PACKAGES" | tr ' ' ',')"
    # Advisory only — never block the push. Full gate runs in CI.
    pnpm turbo run typecheck $FILTERS --continue \
      || echo "  ⚠️  Typecheck reported errors — push continues (CI runs the full gate)"
  else
    echo "  No package changes — skipping typecheck."
  fi
  echo "✅ Pre-push validation complete."
fi

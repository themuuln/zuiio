#!/bin/sh

# ──────────────────────────────────────────────────
# pre-push: lightweight validation before push
# Full CI validation happens in GitHub Actions
# ──────────────────────────────────────────────────

# Parse stdin for pushes targeting 'refs/heads/main'
PUSHING_TO_MAIN=false
while read local_ref local_commit remote_ref remote_commit; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    PUSHING_TO_MAIN=true
  fi
done

# On main-branch pushes, run validation
if [ "$PUSHING_TO_MAIN" = "true" ]; then
  echo "🔍 Push to main detected — running scoped typecheck..."
  CHANGED_APPS=$(git diff --name-only HEAD~1..HEAD 2>/dev/null | cut -d/ -f2 | sort -u | tr '\n' ' ')
  FILTERS=""
  for APP in $CHANGED_APPS; do
    # Skip submodules — they are separate git repos with their own workspaces
    # (turbo filters on them loop inside the submodule, e.g. apps/zoa).
    [ -e "apps/$APP/.git" ] && continue
    if [ -f "apps/$APP/package.json" ]; then
      FILTERS="$FILTERS --filter=./apps/$APP..."
    fi
  done
  if [ -n "$FILTERS" ]; then
    # Scoped to the changed apps + their workspace deps. A bare
    # `turbo run typecheck` spans all 36 projects and takes 30s+,
    # blowing past client-side hook timeouts (e.g. 20s).
    echo "  Apps: $(echo "$CHANGED_APPS" | tr ' ' ',')"
    # Advisory only — never block the push. Full gate runs in CI.
    pnpm turbo run typecheck $FILTERS --continue \
      || echo "  ⚠️  Typecheck reported errors — push continues (CI runs the full gate)"
  else
    echo "  No app package changes — skipping typecheck."
  fi
  echo "✅ Pre-push validation complete."
fi

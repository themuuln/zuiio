auto-install-peers=true

# --- npm publishing (@zuiio) — publish-only --------------------------------
# CI publishes through a GitHub trusted publisher (OIDC), so no token is
# needed there. A local `npm publish` / `npm stage publish` does need a token;
# consuming the public packages never does.
# pnpm 11 ignores credentials with ${VAR} expansion in a *committed* project
# .npmrc (it warns on every run), so the active line is commented; the publish
# script writes its own 0600 temp .npmrc instead and needs nothing from this file.
#
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
#
# For a manual `npm publish` / `npm login`, put the same line in ~/.npmrc, or:
#   pnpm config set "//registry.npmjs.org/:_authToken" "$NPM_TOKEN"

# No scope routing is needed: @zuiio packages live on the default npmjs registry.

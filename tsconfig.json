{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@zer/branding": ["./packages/branding/src/index.ts"],
      "@zer/core": ["./packages/core/src/index.ts"],
      "@zer/export": ["./packages/export/src/index.ts"],
      "@zer/hooks": ["./packages/hooks/src/index.ts"],
      "@zer/i18n": ["./packages/i18n/src/index.ts"],
      "@zer/query": ["./packages/query/src/index.ts"],
      "@zer/supabase": ["./packages/supabase/src/index.ts"],
      "@zer/supabase/auth": ["./packages/supabase/src/auth.ts"],
      "@zer/supabase/errors": ["./packages/supabase/src/errors.ts"],
      "@zer/supabase/query": ["./packages/supabase/src/query.ts"],
      "@zer/supabase/storage": ["./packages/supabase/src/storage.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "templates",
    "docs",
    "vitest.config.ts",
    "vitest.setup.ts",
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}

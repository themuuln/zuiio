{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@zuiio/core": ["./packages/zuiio/packages/core/src/index.ts"],
      "@zuiio/hooks": ["./packages/zuiio/packages/hooks/src/index.ts"],
      "@zuiio/offline": ["./packages/zuiio/packages/offline/src/index.ts"],
      "@zuiio/query": ["./packages/zuiio/packages/query/src/index.ts"],
      "@zuiio/realtime": ["./packages/zuiio/packages/realtime/src/index.ts"],
      "@zuiio/ui": ["./packages/zuiio/packages/ui/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/zuiio/packages/*/src/**/*.ts",
    "packages/zuiio/packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "supabase",
    "scratch",
    "templates",
    "packages/zuiio/src",
    "packages/zuiio/apps",
    "packages/zer/src",
    "packages/zer/apps",
    "packages/zuiio/packages/*/node_modules",
    "packages/zer/packages/*/node_modules",
    "packages/zer/tests",
    "packages/zer/templates",
    "packages/zer/vitest.config.ts",
    "packages/zuiio/node_modules",
    "packages/zer/node_modules"
  ]
}

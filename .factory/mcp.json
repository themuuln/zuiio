{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "supabase-tolom": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=fhzuolncswccxkcqzclg&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode-mcp-server"],
      "env": {
        "CONTEXT_DIR": "/Users/themuuln/.commandcode/context-data",
        "FTS5_DB_PATH": "/Users/themuuln/.commandcode/context-data/fts5.db"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
